# Copy to backend/.env.docker (never commit real secrets)
APP_ENV=production
LOG_LEVEL=INFO

# Persistent SQLite path inside the mounted ./backend/data:/app/data volume
DATABASE_URL=sqlite+aiosqlite:////app/data/dev_local.db
DATABASE_MIGRATION_URL=sqlite+aiosqlite:////app/data/dev_local.db

# Clerk Authentication
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=

# Exact Netlify frontend origin (no wildcard)
CORS_ALLOWED_ORIGINS=https://lighthearted-sawine-87d3a5.netlify.app

# Hugging Face Router (server-side only)
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
HF_TIMEOUT_SECONDS=20.0
DAILY_MEAL_SCHEDULER_ENABLED=true
DAILY_MEAL_SCHEDULER_POLL_SECONDS=60
